# Porta da API (o front aponta para http://localhost:8080/api)
PORT=8080

# Conexão com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=predictmaint
# Fuso das datas (precisa ser o mesmo do "SET time_zone" do seed.sql)
DB_TIMEZONE=-03:00

# Segredo usado para assinar o token de login (troque em produção!)
JWT_SECRET=troque-este-segredo

# Endereço(s) do front-end liberados no CORS, separados por vírgula
CORS_ORIGIN=http://localhost:3000
