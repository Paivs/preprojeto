@baseUrl = http://localhost:8080
@protectedUrl = {{baseUrl}}/api/usuarios
@emailTeste = fluxo.matricula.{{$timestamp}}@example.com
@cpfTeste = 90000000{{$randomInt}}{{$randomInt}}
@senhaTeste = Tenken123!

### 1. Gerar matrícula válida; guardar matrícula retornada
# Guarde o valor de "matricula" da resposta para as requisições abaixo.
POST {{baseUrl}}/api/alunos/gerar-matricula
Content-Type: application/json

{
  "nome": "Aluno Fluxo HTTP",
  "email": "{{emailTeste}}",
  "cpf": "{{cpfTeste}}",
  "telefone": "11999990000"
}

### 2. Gerar com o mesmo e-mail: 409 e resposta sem matrícula
POST {{baseUrl}}/api/alunos/gerar-matricula
Content-Type: application/json

{
  "nome": "Aluno Fluxo HTTP Duplicado",
  "email": "{{emailTeste}}",
  "cpf": "90000000000",
  "telefone": "11999990000"
}

### 3. Gerar sem nome: 400 com errors
POST {{baseUrl}}/api/alunos/gerar-matricula
Content-Type: application/json

{
  "email": "sem.nome.{{$timestamp}}@example.com",
  "cpf": "91111111111"
}

### 4. Cadastrar com matrícula da resposta do passo 1 e senha de 8+ caracteres: 201
# Substitua MAT-XXXXX pela matrícula retornada no passo 1.
POST {{baseUrl}}/api/alunos/cadastro
Content-Type: application/json

{
  "matricula": "MAT-XXXXX",
  "senha": "{{senhaTeste}}",
  "confirmarSenha": "{{senhaTeste}}"
}

### 5. Cadastrar novamente com a mesma matrícula: 409
POST {{baseUrl}}/api/alunos/cadastro
Content-Type: application/json

{
  "matricula": "MAT-XXXXX",
  "senha": "{{senhaTeste}}",
  "confirmarSenha": "{{senhaTeste}}"
}

### 6. Cadastrar com matrícula inexistente: 404
POST {{baseUrl}}/api/alunos/cadastro
Content-Type: application/json

{
  "matricula": "MAT-99999-INEXISTENTE",
  "senha": "{{senhaTeste}}",
  "confirmarSenha": "{{senhaTeste}}"
}

### 7. Login com matrícula e senha certas: 200 com token
POST {{baseUrl}}/api/usuarios/login
Content-Type: application/json

{
  "matricula": "MAT-XXXXX",
  "senha": "{{senhaTeste}}"
}

### 8. Login com senha errada: 401 e mesma mensagem para matrícula inexistente
POST {{baseUrl}}/api/usuarios/login
Content-Type: application/json

{
  "matricula": "MAT-XXXXX",
  "senha": "SenhaErrada123!"
}

### 9. Rota protegida sem token: 401
# Defina PROTECTED_URL se houver outra rota protegida disponível.
GET {{protectedUrl}}

### 10. Banco: confirmar que o hash começa com "$2b$"
# Execute no MySQL usando a matrícula criada no passo 1.
SELECT matricula, LEFT(senha_hash, 4) AS prefixo_hash,
       LEFT(senha_hash, 4) = '$2b$' AS comeca_com_2b
FROM usuarios
WHERE matricula = 'MAT-XXXXX';
